pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    parameters {
        booleanParam(
            name: 'CLAIMS_DEMO_API',
            defaultValue: true,
            description: 'Build and deploy Claims Demo API to PreProd'
        )
    }

    environment {
        APP_REPO_URL = 'https://github.com/mnasir129/claims-demo-app.git'
        AUTOMATION_REPO_URL = 'https://github.com/mnasir129/claims-demo-automation.git'

        APP_BRANCH = 'feature/preprod'
        AUTOMATION_BRANCH = 'develop'

        GIT_CREDENTIALS_ID = 'github-token'
        WINDOWS_CREDENTIALS_ID = 'windows-creds'
        ANSIBLE_VAULT_CREDENTIAL_ID = 'claims-demo-ansible-vault-password'

        NUGET_GROUP_URL = 'http://172.28.52.31:8081/repository/nuget-group/index.json'

        DOTNET_BUILD_IMAGE = '172.28.52.31:8081/docker-hosted/local-dotnet9:latest'
        ANSIBLE_IMAGE = '172.28.52.31:8081/docker-hosted/local-ansible-winrm:latest'
    }

    stages {
        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout Application') {
            when {
                expression { return params.CLAIMS_DEMO_API }
            }
            steps {
                dir('source') {
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: "*/${APP_BRANCH}"]],
                        userRemoteConfigs: [[
                            url: "${APP_REPO_URL}",
                            credentialsId: "${GIT_CREDENTIALS_ID}"
                        ]]
                    ])
                }
            }
        }

        stage('Build Claims Demo API') {
            when {
                expression { return params.CLAIMS_DEMO_API }
            }
            steps {
                script {
                    def uid = sh(returnStdout: true, script: 'id -u').trim()
                    def gid = sh(returnStdout: true, script: 'id -g').trim()

                    docker.image(DOTNET_BUILD_IMAGE).inside("--network host --user ${uid}:${gid} -e HOME=/tmp -e DOTNET_CLI_HOME=/tmp -e NUGET_GROUP_URL=${NUGET_GROUP_URL}") {
                        def hipCommonLib = library('hip-common-lib@main')

                        hipCommonLib.ae.damanhealth.DockerDotnet.setupDotnetNonProdRepositories(this, NUGET_GROUP_URL)

                        dir('source/ClaimsDemo.API') {
                            hipCommonLib.ae.damanhealth.DockerDotnet.runDotnetShellScriptWithProxy(this, '''
                                rm -rf bin obj deploy
                                rm -f claimsDemoAPI.tar.gz

                                dotnet publish --configuration Release -p:PublishProfile=CICD

                                tar -cvzf claimsDemoAPI.tar.gz \
                                    -C deploy \
                                    --exclude='appsettings*.json' \
                                    .

                                ls -lh claimsDemoAPI.tar.gz

                                tar -tzf claimsDemoAPI.tar.gz | grep -i appsettings && {
                                    echo "ERROR: appsettings file should not be inside artifact"
                                    exit 1
                                } || echo "PASS: appsettings excluded from artifact"

                                tar -tzf claimsDemoAPI.tar.gz | grep -i web.config
                                tar -tzf claimsDemoAPI.tar.gz | grep -i ClaimsDemo.API.dll
                            ''')

                            stash name: 'claims-demo-api-artifact', includes: 'claimsDemoAPI.tar.gz'
                        }
                    }
                }
            }
        }

        stage('Checkout Automation') {
            when {
                expression { return params.CLAIMS_DEMO_API }
            }
            steps {
                dir('automation') {
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: "*/${AUTOMATION_BRANCH}"]],
                        userRemoteConfigs: [[
                            url: "${AUTOMATION_REPO_URL}",
                            credentialsId: "${GIT_CREDENTIALS_ID}"
                        ]]
                    ])

                    unstash 'claims-demo-api-artifact'
                }
            }
        }

        stage('Deploy Claims Demo API') {
            when {
                expression { return params.CLAIMS_DEMO_API }
            }
            steps {
                script {
                    def uid = sh(returnStdout: true, script: 'id -u').trim()
                    def gid = sh(returnStdout: true, script: 'id -g').trim()

                    withCredentials([
                        usernamePassword(
                            credentialsId: "${WINDOWS_CREDENTIALS_ID}",
                            usernameVariable: 'ANSIBLE_REMOTE_USER',
                            passwordVariable: 'ANSIBLE_REMOTE_PASSWORD'
                        ),
                        string(
                            credentialsId: "${ANSIBLE_VAULT_CREDENTIAL_ID}",
                            variable: 'VAULT_PASSWORD'
                        )
                    ]) {
                        dir('automation/ansible') {
                            sh '''
                                set +x

                                printf '%s\\n' "$ANSIBLE_REMOTE_PASSWORD" > windows_password
                                printf '%s\\n' "$VAULT_PASSWORD" > vault_password

                                chmod 600 windows_password vault_password

                                cp ../claimsDemoAPI.tar.gz claimsDemoAPI.tar.gz
                                ls -lh claimsDemoAPI.tar.gz
                            '''

                            def ansibleDir = pwd()

                            docker.image(ANSIBLE_IMAGE).inside("--network host --user ${uid}:${gid} -e HOME=/tmp -e ANSIBLE_REMOTE_USER -e ANSIBLE_CONNECTION_PASSWORD_FILE=${ansibleDir}/windows_password -e ANSIBLE_VAULT_PASSWORD_FILE=${ansibleDir}/vault_password -e ANSIBLE_CONFIG=${ansibleDir}/ansible.cfg") {
                                def hipCommonLib = library('hip-common-lib@main')

                                hipCommonLib.ae.damanhealth.DockerAnsible.installWinRMDependencies(this)

                                sh '''
                                    set -e

                                    ansible-playbook -v \
                                        -i inventories/preprod/hosts \
                                        playbooks/deploy/deploy_integration_apis.yml \
                                        --extra-vars "deploy_parallelism=100%" \
                                        --extra-vars "claims_demo_api_code_tarball=$PWD/claimsDemoAPI.tar.gz"
                                '''
                            }
                        }
                    }
                }
            }
        }

        stage('Verify Deployment') {
            when {
                expression { return params.CLAIMS_DEMO_API }
            }
            steps {
                sh '''
                    set -e

                    echo "Checking Claims Demo API health endpoint"
                    curl -i http://172.28.51.217:8090/health

                    echo "Checking Claims Demo API root endpoint"
                    curl -s http://172.28.51.217:8090/ | python3 -m json.tool
                '''
            }
        }
    }

    post {
        always {
            sh '''
                rm -f automation/ansible/windows_password || true
                rm -f automation/ansible/vault_password || true
                rm -f automation/ansible/claimsDemoAPI.tar.gz || true
            '''
        }
    }
}
